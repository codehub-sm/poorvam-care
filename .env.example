# Server-side only. Never expose the secret to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Browser-side (Vite inlines VITE_* at build time). Key ID only.
VITE_RAZORPAY_KEY_ID=

# Where the browser calls the payments API. Leave empty for same-origin
# (local dev / server.js). Prod on Amplify: the API Gateway base URL.
VITE_PAYMENTS_API_URL=

# Set on the Lambda when the API is on a different origin from the site.
PAYMENTS_CORS_ORIGIN=

# Razorpay Payment Buttons (hosted checkout, no backend). Public `pl_…` ids
# from Dashboard → Payment Button. Test-mode ids for dev, live ids on Amplify.
VITE_RAZORPAY_BUTTON_CONSULTATION=
VITE_RAZORPAY_BUTTON_DEVELOPMENTAL_ASSESSMENT=
VITE_RAZORPAY_BUTTON_AUTISM_SCREENING=
