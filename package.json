{
  "name": "poorvamcare-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "poorvamcare.in: static site, no runtime dependencies. node build.mjs writes dist/.",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "node build.mjs",
    "draft": "DRAFT=1 node build.mjs",
